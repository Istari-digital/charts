apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: zitadel-registry-service-env
stringData:
  FILE_SERVICE_ZITADEL_DOMAIN: "${common_domain}"
  FILE_SERVICE_ZITADEL_JWKS_URL: "${common_domain}/oauth/v2/keys"
  FILE_SERVICE_ZITADEL_CLIENT_ID: "${rs_zitadel_client_id}"
  FILE_SERVICE_ZITADEL_PROJECT_ID: "${rs_zitadel_project_id}"
  FILE_SERVICE_ZITADEL_PROJECT_GRANT_ID: "${rs_zitadel_project_grant_id}"
  FILE_SERVICE_ZITADEL_SECRET: "${rs_zitadel_secret}"
  FILE_SERVICE_ZITADEL_USER_MANAGER_SECRET: "${rs_zitadel_user_manager_secret}"
%{ if identity_client_integration_enabled ~}
  # Identity-service cutover (DPLAT-653): flag, URL, and the PRIVATE client
  # credential blob the registry signs its introspection assertion with.
  FILE_SERVICE_FEATURE_FLAGS__IDENTITY_ROUTER_ENABLED: "true"
  FILE_SERVICE_IDENTITY_ROUTER_URL: "${identity_service_base_url}"
  FILE_SERVICE_IDENTITY_ROUTER_SECRET: "${identity_registry_private_blob}"
%{ endif ~}
---
apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: zitadel-secure-connection-env
stringData:
  ISTARI_DIGITAL_REGISTRY_SERVICE_ZITADEL_DOMAIN: "${common_domain}"
  ISTARI_DIGITAL_REGISTRY_SERVICE_ZITADEL_PROJECT_ID: "${scs_zitadel_project_id}"
  ISTARI_DIGITAL_SECURE_CONNECTION_SERVICE_ZITADEL_DOMAIN: "${common_domain}"
  ISTARI_DIGITAL_SECURE_CONNECTION_SERVICE_ZITADEL_JWKS_URL: "${common_domain}/oauth/v2/keys"
  ISTARI_DIGITAL_SECURE_CONNECTION_SERVICE_PROJECT_ID: "${scs_zitadel_project_id}"
  ISTARI_DIGITAL_SECURE_CONNECTION_SERVICE_PROJECT_GRANT_ID: "${scs_zitadel_project_grant_id}"
  ISTARI_DIGITAL_SECURE_CONNECTION_SERVICE_ZITADEL_ROLE_NAME: "${scs_zitadel_role_name}"
  ISTARI_DIGITAL_SECURE_CONNECTION_SERVICE_ZITADEL_SECRET: "${scs_zitadel_user_manager_secret}"
%{ if identity_client_integration_enabled ~}
  # Identity-service cutover (DPLAT-653). Names follow the shipping SCS
  # contract; DPLAT-646 renames them to IDENTITY_SERVICE forms.
  ISTARI_DIGITAL_IDENTITY_ROUTER_ENABLED: "true"
  ISTARI_DIGITAL_IDENTITY_ROUTER_URL: "${identity_service_base_url}"
  # PRIVATE agent credential blob; its public half is registered by the
  # istari-platform agent-registration hook.
  ISTARI_DIGITAL_IDENTITY_ROUTER_AGENT_KEY: "${identity_scs_agent_private_blob}"
%{ endif ~}
---
apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: zitadel-frontend-service-env
stringData:
  VITE_ZITADEL_AUTHORITY: "${common_domain}"
  ZITADEL_CLOUD_URL: "${common_domain}"
  VITE_CLIENT_ID: "${fe_zitadel_client_id}"
  VITE_ZITADEL_CLIENT_ID: "${fe_zitadel_client_id}"
  ZITADEL_CLOUD_CLIENT_ID: "${fe_zitadel_client_id}"
  ZITADEL_CLOUD_REQUEST_SCOPE: "openid profile email offline_access urn:zitadel:iam:org:project:id:zitadel:aud"
%{ if identity_client_integration_enabled ~}
  # Identity-service cutover (DPLAT-653): the frontend's public (PKCE) client.
  VITE_IDENTITY_ROUTER_ENABLED: "true"
  VITE_IDENTITY_ROUTER_AUTHORITY: "${identity_service_base_url}"
  VITE_IDENTITY_ROUTER_CLIENT_ID: "${identity_frontend_client_id}"
%{ endif ~}
---
apiVersion: v1
type: Opaque
kind: Secret
metadata:
  name: zitadel-magic-docs-env
stringData:
  VITE_ZITADEL_AUTHORITY: "${common_domain}"
  VITE_ZITADEL_CLIENT_ID: "${fe_zitadel_client_id}"
  ZITADEL_CLOUD_CLIENT_ID: "${fe_zitadel_client_id}"
  ZITADEL_CLOUD_REQUEST_SCOPE: "openid profile email offline_access urn:zitadel:iam:org:project:id:zitadel:aud"
  ZITADEL_CLOUD_URL: "${common_domain}"
---
apiVersion: v1
type: Opaque
kind: Secret
metadata:
  name: zitadel-identity-service-env
stringData:
  ISTARI_DIGITAL_IDENTITY_SERVICE_OIDC_ISSUER: "${zitadel_domain}"
  ISTARI_DIGITAL_IDENTITY_SERVICE_BASE_URL: "${identity_service_base_url}"
  ISTARI_DIGITAL_IDENTITY_SERVICE_OIDC_CLIENT_ID: "${identity_service_zitadel_client_id}"
  ISTARI_DIGITAL_IDENTITY_SERVICE_OIDC_PRIVATE_KEY: "${identity_service_zitadel_private_key}"
  # Dedicated read-only (ORG_OWNER_VIEWER) Zitadel machine key for the
  # identity-service's management API calls — the customer_admin user-grants
  # lookup behind the admin key-management endpoints. Absent, admin key ops
  # degrade to non-admin (every caller gets 403 "admin role required").
  ISTARI_DIGITAL_IDENTITY_SERVICE_ZITADEL_MANAGER_KEY: "${identity_service_zitadel_manager_key}"
  # SCS agent binding for the identity-service agent-registration hook: the
  # Zitadel machine-user id (register-agent -username) and its org id
  # (create-tenant -provider-tenant-id, emitted as the resourceowner). Published
  # here so the hook reads them by stable key name — no per-environment ids in
  # gitops. See DPLAT-513.
  ISTARI_DIGITAL_IDENTITY_SERVICE_SCS_AGENT_USERNAME: "${scs_zitadel_user_id}"
  ISTARI_DIGITAL_IDENTITY_SERVICE_SCS_AGENT_PROVIDER_TENANT_ID: "${zitadel_org_id}"
%{ if identity_generate_keys ~}
  # Generated by the configurator (DPLAT-653). Signs every issued token and
  # backs /.well-known/jwks.json. Rotate via identity_key_rotation_signing_key.
  ISTARI_DIGITAL_IDENTITY_SERVICE_SIGNING_KEY: "${identity_signing_key_blob}"
  # AES-256 at-rest key for stored token material. Rotation invalidates old
  # rows (users re-login once).
  ISTARI_DIGITAL_IDENTITY_SERVICE_TOKEN_ENCRYPTION_KEY: "${identity_token_encryption_key}"
%{ endif ~}
%{ if identity_client_integration_enabled ~}
  # PUBLIC half of the registry's client credential; the
  # registry-client-registration hook upserts it into the ClientStore. The
  # private half goes only to zitadel-registry-service-env.
  ISTARI_DIGITAL_IDENTITY_SERVICE_REGISTRY_CLIENT: "${identity_registry_public_blob}"
  # Allowlist the registry's client_id on POST /api/v1/agents (agent
  # provisioning). Absent, agent creation through the platform fails.
  ISTARI_DIGITAL_IDENTITY_SERVICE_AGENT_PROVISIONING_CLIENT_IDS: "${identity_registry_client_id}"
  # Frontend public (PKCE) client id + exact-match redirect allowlist for the
  # public-client-registration hook. No key material: public clients have none.
  ISTARI_DIGITAL_IDENTITY_SERVICE_FRONTEND_CLIENT_ID: "${identity_frontend_client_id}"
  ISTARI_DIGITAL_IDENTITY_SERVICE_FRONTEND_REDIRECT_URIS: "${identity_frontend_redirect_uris}"
  # PUBLIC half of the SCS agent credential for the agent-registration hook;
  # joins SCS_AGENT_USERNAME / SCS_AGENT_PROVIDER_TENANT_ID above (DPLAT-513).
  ISTARI_DIGITAL_IDENTITY_SERVICE_SCS_AGENT: "${identity_scs_agent_public_blob}"
%{ endif ~}
%{ if identity_mcp_enabled ~}
  ISTARI_DIGITAL_IDENTITY_SERVICE_MCP_CLIENT_ID: "${identity_mcp_client_id}"
  ISTARI_DIGITAL_IDENTITY_SERVICE_MCP_REDIRECT_URIS: "${identity_mcp_redirect_uris}"
%{ endif ~}
---
apiVersion: v1
type: Opaque
kind: Secret
metadata:
  name: zitadel-istari-mcp-env
stringData:
  ISTARI_DIGITAL_ZITADEL_CLIENT_ID: "${mcp_zitadel_client_id}"
  ISTARI_DIGITAL_ZITADEL_ISSUER: "${common_domain}"
  ISTARI_DIGITAL_ZITADEL_CLIENT_SECRET: "${mcp_zitadel_secret}"
%{ if identity_mcp_enabled ~}
  # Identity-service cutover (DPLAT-653).
  ISTARI_DIGITAL_IDENTITY_SERVICE_ENABLED: "true"
  ISTARI_DIGITAL_IDENTITY_SERVICE_ISSUER: "${identity_service_base_url}"
  ISTARI_DIGITAL_IDENTITY_SERVICE_CLIENT_ID: "${identity_mcp_client_id}"
  # Kept to satisfy the current MCP env contract; DPLAT-647 may remove it.
  ISTARI_DIGITAL_IDENTITY_SERVICE_CLIENT_SECRET: "${identity_mcp_client_secret}"
%{ endif ~}
